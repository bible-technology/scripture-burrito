{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://burrito.bible/schema/ingredient.schema.json",
    "$$target": "ingredient.schema.json",
    "title": "Ingredient",
    "type": "object",
    "description": "Describes an individual ingredient, which is a file contained within the burrito.",
    "properties": {
        "size": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of bytes that this ingredient takes up on disk."
        },
        "lang": {"$ref": "common.schema.json#/definitions/languageTag"},
        "mimeType": {"$ref": "common.schema.json#/definitions/mimeType"},
        "checksum": {
            "type": "object",
            "properties": {
                "md5": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{32}$"
                },
                "sha3-256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                },
                "sha3-512": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{128}$"
                }
            },
            "required": ["md5"],
            "maxProperties": 2,
            "additionalProperties": false
        },
        "scope": {"$ref": "scope.schema.json"},
        "role": {"$ref": "role.schema.json"},
        "properties": {
            "type": "object",
            "properties": {
                "performance": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "singleVoice",
                            "multipleVoice",
                            "nonDrama",
                            "drama",
                            "withMusic",
                            "withEffects",
                            "withHeadings"
                        ]
                    },
                    "uniqueItems": true,
                    "allOf": [
                        {
                            "if": {
                                "contains": {"const": "singleVoice"}
                            },
                            "then": {
                                "not": {
                                    "contains": {"const": "multipleVoice"}
                                }
                            },
                            "else": {
                                "contains": {"const": "multipleVoice"}
                            }
                        },
                        {
                            "if": {
                                "contains": {"const": "nonDrama"}
                            },
                            "then": {
                                "not": {
                                    "contains": {"const": "drama"}
                                }
                            },
                            "else": {
                                "contains": {"const": "drama"}
                            }
                        }
                    ]
                }
            }, 
            "patternProperties": {
                "^x-[a-z][a-zA-Z0-9]*$": {"type": "string"}
            },
            "additionalProperties": false
        }
    },  
    "required": [
        "size",
        "mimeType"
    ],
    "additionalProperties": false
}