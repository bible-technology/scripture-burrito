{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.org/schemas/audio-metadata.schema.json",
    "title": "Audio Translation Metadata",
    "type": "object",
    "required": [
        "format",
        "meta",
        "identification",
        "languages",
        "type",
        "ingredients"
    ],
    "properties": {
        "format": {
            "type": "string",
            "const": "scripture burrito"
        },
        "meta": {
            "type": "object",
            "required": [
                "category",
                "version",
                "dateCreated"
            ],
            "properties": {
                "category": {
                    "type": "string",
                    "enum": [
                        "source",
                        "derived"
                    ]
                },
                "version": {"type": "string"},
                "dateCreated": {
                    "type": "string",
                    "format": "date-time"
                },
                "generator": {
                    "type": "object",
                    "properties": {
                        "softwareName": {"type": "string"},
                        "softwareVersion": {"type": "string"}
                    },
                    "required": ["softwareName"]
                },
                "defaultLocale": {"type": "string"},
                "comments": {
                    "type": "array",
                    "items": {"type": "string"}
                }
            },
            "additionalProperties": true
        },
        "identification": {
            "type": "object",
            "required": [
                "name",
                "primary"
            ],
            "properties": {
                "name": {
                    "type": "object",
                    "additionalProperties": {"type": "string"}
                },
                "abbreviation": {"type": "string"},
                "primary": {
                    "type": "object",
                    "required": ["bibleId"],
                    "properties": {
                        "bibleId": {"type": "string"},
                        "revision": {"type": "string"}
                    }
                }
            },
            "additionalProperties": true
        },
        "languages": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["tag"],
                "properties": {
                    "tag": {
                        "type": "string",
                        "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]+)*$"
                    },
                    "name": {"type": "string"},
                    "scriptDirection": {
                        "type": "string",
                        "enum": [
                            "ltr",
                            "rtl"
                        ]
                    }
                },
                "additionalProperties": true
            }
        },
        "type": {
            "type": "object",
            "required": ["flavorType"],
            "properties": {
                "flavorType": {
                    "type": "object",
                    "required": [
                        "name",
                        "flavor"
                    ],
                    "properties": {
                        "name": {
                            "type": "string",
                            "const": "scripture"
                        },
                        "flavor": {
                            "type": "object",
                            "required": ["name"],
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "const": "audioTranslation"
                                },
                                "performance": {
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "enum": [
                                            "singleVoice",
                                            "multipleVoice",
                                            "reading",
                                            "drama",
                                            "withMusic",
                                            "withEffects",
                                            "withHeadings"
                                        ]
                                    },
                                    "uniqueItems": true
                                }
                            },
                            "additionalProperties": true
                        }
                    }
                }
            },
            "additionalProperties": true
        },
        "ingredients": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "object",
                "required": [
                    "mimeType",
                    "scope"
                ],
                "properties": {
                    "mimeType": {
                        "type": "string",
                        "pattern": "^audio\\/"
                    },
                    "size": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "checksum": {
                        "type": "object",
                        "properties": {
                            "md5": {
                                "type": "string",
                                "pattern": "^[a-fA-F0-9]{32}$"
                            },
                            "sha256": {
                                "type": "string",
                                "pattern": "^[a-fA-F0-9]{64}$"
                            }
                        },
                        "additionalProperties": false
                    },
                    "scope": {
                        "type": "object",
                        "minProperties": 1,
                        "additionalProperties": {
                            "type": "array",
                            "items": {"type": "string"}
                        }
                    }
                },
                "additionalProperties": true
            }
        },
        "relationships": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["relationType"],
                "properties": {
                    "relationType": {"type": "string"},
                    "flavor": {"type": "string"},
                    "id": {"type": "string"},
                    "revision": {"type": "string"}
                },
                "additionalProperties": true
            }
        },
        "agencies": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "role",
                    "name"
                ],
                "properties": {
                    "role": {"type": "string"},
                    "name": {"type": "string"}
                },
                "additionalProperties": true
            }
        },
        "copyright": {
            "type": "object",
            "properties": {
                "shortStatements": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["statement"],
                        "properties": {
                            "statement": {"type": "string"}
                        }
                    }
                }
            },
            "additionalProperties": true
        }
    },
    "additionalProperties": true
}
