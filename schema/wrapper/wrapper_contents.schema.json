{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://burrito.bible/schema/wrapper/wrapper_contents.schema.json",
    "$$target": "wrapper_contents.schema.json",
    "title": "Wrapper Contents",
    "type": "object",
    "description": "Lists the burritos contained by this wrapper.",
    "properties": {
        "burritos": {
            "type": "array",
            "items": {
                "$ref": "wrapper_burrito.schema.json"
            },
            "minItems": 1,
            "description": "Contained burritos, each at a path relative to the wrapper root."
        }
    },
    "required": ["burritos"],
    "additionalProperties": false
}
