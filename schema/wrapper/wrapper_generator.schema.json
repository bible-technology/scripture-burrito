{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://burrito.bible/schema/wrapper/wrapper_generator.schema.json",
    "$$target": "wrapper_generator.schema.json",
    "title": "Wrapper Generator",
    "type": "object",
    "description": "Information about the program that generated this wrapper metadata file.",
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the program used."
        },
        "version": {
            "type": "string",
            "minLength": 1,
            "description": "The version of the program used."
        }
    },
    "required": ["name", "version"],
    "additionalProperties": false
}
